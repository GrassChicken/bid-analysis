# ==================== 敏感信息 ====================
# 环境配置文件（包含 API Key、密码等）
.env
.env.*
!.env.example
*.pem
*.key

# ==================== 数据库文件 ====================
# SQLite 数据库（数据不提交到 Git）
*.db
*.db-journal
*.sqlite
*.sqlite3

# ==================== 日志文件 ====================
*.log
*.log.*
logs/

# ==================== 临时文件 ====================
# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 编辑器临时文件
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ==================== 运行时文件 ====================
# PID 文件
*.pid

# 上传的临时文件
uploads/
tmp/
temp/

# ==================== 备份文件 ====================
backups/
*.bak
*.backup
*.tar.gz
*.zip

# ==================== 系统文件 ====================
.DS_Store
Thumbs.db
._*

# ==================== Jupyter Notebook ====================
.ipynb_checkpoints

# ==================== 测试与覆盖率 ====================
.pytest_cache/
.coverage
htmlcov/
.tox/

# ==================== 虚拟环境 ====================
venv/
env/
ENV/
.venv
.venv*

# ==================== 分发与打包 ====================
build/
dist/
*.egg-info/
.eggs/

# ==================== 其他 ====================
# 如果某些文件需要例外，使用 ! 前缀
# !important.env
